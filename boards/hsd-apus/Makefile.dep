ifneq (,$(filter saul_default,$(USEMODULE)))
  USEMODULE += saul_adc
  USEMODULE += saul_gpio
  USEMODULE += saul_pwm
  USEMODULE += lm75a
endif

ifneq (,$(filter disp_dev,$(USEMODULE)))
  USEMODULE += st7789
endif

ifneq (,$(filter st7789,$(USEMODULE)))
  USEMODULE += lcd_parallel
endif

ifneq (,$(filter walltime_impl_mcp79410,$(USEMODULE)))
  USEMODULE += mcp79410
endif
